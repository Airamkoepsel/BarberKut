# Copie para .env (ou exporte no shell / configure no seu provedor de deploy).
# NUNCA commite o .env real.

# Connection string JDBC do Postgres do Supabase.
# Em Supabase: Settings -> Database -> Connection string -> JDBC.
# Exemplo de formato (preencha com os valores reais do seu projeto):
SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<SENHA_DO_BANCO>

# Usado na etapa P0.3 (validação do JWT do Supabase Auth) — ainda não usado nesta etapa.
# Em Supabase: Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=<JWT_SECRET_DO_SUPABASE>
